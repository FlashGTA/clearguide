{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlashGTA/clearguide/schema/guide.schema.json",
  "title": "ClearGuide Guide Template",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "steps"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "domain": { "type": "string" },
    "originUrl": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message", "urlPattern"],
        "properties": {
          "selector": { "type": ["string", "null"] },
          "label": { "type": "string", "maxLength": 120 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "urlPattern": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string" },
          "actionRequired": { "type": "boolean" },
          "interactionType": { "type": "string" },
          "autoAdvance": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
